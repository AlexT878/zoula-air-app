# =============================================================
#                       DATABASE CONFIG
# =============================================================
DB_USER=user_zoula
DB_PASSWORD=password_example_change_me
DB_NAME=zoula_db
DB_HOST_LOCAL=localhost
DB_HOST_DOCKER=db
DB_PORT=5432

# =============================================================
#                       BACKEND SECRETS
# =============================================================

DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST_LOCAL}:${DB_PORT}/${DB_NAME}
DOCKER_DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST_DOCKER}:${DB_PORT}/${DB_NAME}

# --- SECURITY ---
# Generate a real one using: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-super-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ADMIN_PASSWORD=admin-password-example